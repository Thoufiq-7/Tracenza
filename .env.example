# Tracenza Local Development Environment Template
# Copy this file to .env and configure for your environment:
# cp .env.example .env

APP_NAME=Tracenza
ENVIRONMENT=development
DATABASE_URL=sqlite:///./validex.db
# DATABASE_URL=postgresql://aicte:your_secure_password@localhost:5432/tracenza_compliance

# Async Processing: false = FastAPI in-process background tasks; true = Celery + Redis workers
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# Object Storage: falls back to local backend/storage_vault when MinIO is disabled
USE_MINIO=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=aicte-documents

# Issuing-Authority Connector: empty = in-process simulated sources; or URL of mock-authority service
AUTHORITY_API_URL=

# Security & JWT Token Signing
# Generate a random 64-char hex key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_64_character_hex_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Document Limits & Retention
MAX_UPLOAD_MB=25
RETENTION_DAYS=365

# Multi-Channel Alert Dispatch (SMTP Email Queue)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tracenza.gov.in
