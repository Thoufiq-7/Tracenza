# =====================================================================
# Tracenza — Version Control Ignore Configuration
# =====================================================================

# Environment Variables & Sensitive Credentials
.env
.env.*
.env.local
.env.*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!.env.production.example
!frontend/.env.example

# Secret Keys, Certificates & Tokens
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cert
credentials.json
secrets/
id_rsa*
*.secret

# Databases & Local Storage Vaults
*.db
*.db-journal
*.sqlite
*.sqlite3
validex.db
backend/validex.db
tracenza.db
backend/tracenza.db
storage_vault/
backend/storage_vault/
sample_docs/temp/

# Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local

# Logs & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*~

# Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ML Models & Generated Artefacts
backend/ml_models/
ml_models/
sample_docs/eval/
sample_docs/lab_photos/*
!sample_docs/lab_photos/README.md
