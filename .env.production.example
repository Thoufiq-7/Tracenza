# Tracenza Production Environment Template (docker-compose.prod.yml)
# All values marked REQUIRED must be configured before running production.

SECRET_KEY=                 # REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_USER=aicte
POSTGRES_PASSWORD=          # REQUIRED: strong database password
POSTGRES_DB=tracenza_compliance
MINIO_ROOT_USER=            # REQUIRED: MinIO admin username
MINIO_ROOT_PASSWORD=        # REQUIRED: MinIO admin password (min 8 chars)
NEO4J_PASSWORD=             # REQUIRED: Neo4j password (for collusion graph)
CORS_ORIGINS=https://tracenza.gov.in,https://tracenza.vercel.app
RETENTION_DAYS=365
AUTHORITY_API_URL=http://mock-authority:8100
